# Database path is resolved relative to the project root when it is not absolute.
DATABASE_PATH=data/database/personal_finance.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_ENV=development
DEBUG=True

# Required: choose the database profile served by this local, single-user API.
# Requests are scoped to this ID; no user list is exposed by the API.
FINANCE_USER_ID=

# Internal AI sidecar; start ai-service/api.py separately.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=120
FINANCE_EXPLANATION_OUTPUT_DIR=data/processed/explainability

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Data Paths
DATA_RAW_PATH=./data/raw/
DATA_PROCESSED_PATH=./data/processed/

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
